{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Skaldic",
  "version": "0.3.0",
  "identifier": "com.skaldic.bard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Skaldic",
        "width": 920,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost blob:",
        "script-src": "'self' blob:",
        "worker-src": "blob:"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:5173 blob:",
        "script-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "blob:"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFODMzMjE2Mzk1NUVCRDcKUldUWDYxVTVGaktEL3ZTckc2SjN6N2lNUTY2eU5xTjdyYWxtUFNuOHY0YlFxbmtyR1RyMEw3NlAK",
      "endpoints": [
        "https://shayhenderson.dev/skaldic/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": ["resources/template.sav"],
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
